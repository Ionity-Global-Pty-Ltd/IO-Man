{
  "hosting": {
    "site": "io-man",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "firebase/**",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "previews/**",
      "tests/**",
      "v1/**",
      "*.md",
      "LICENSE",
      "CNAME"
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  },
  "database": {
    "rules": "firebase/database.rules.json"
  }
}
