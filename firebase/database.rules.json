{
  "rules": {
    ".read": true,
    "players": {
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name','level','className']) && newData.child('name').val().length <= 18"
      }
    },
    "presence": {
      "$realm": {
        "$sector": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "world": {
      "$realm": {
        "$sector": {
          ".write": "auth != null"
        }
      }
    },
    "chat": {
      "$realm": {
        ".write": "auth != null",
        "$msgId": {
          ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').val() == auth.uid && newData.child('text').val().length <= 240 && newData.child('name').val().length <= 18"
        }
      }
    },
    "leaderboard": {
      ".indexOn": ["score"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid','name','level','score']) && newData.child('uid').val() == auth.uid"
      }
    }
  }
}
